rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ユーザードキュメント：本人のみ読み書き可
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 保留中決済：Functions経由のみ（直接アクセス不可）
    match /pendingPayments/{paymentId} {
      allow read: if false;
      allow write: if false;
    }

    // 虹の橋：ペットメモリアル（本人のみ読み書き）
    match /memorials/{uid}/pets/{petId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 虹の橋：チャット履歴（本人のみ読み書き）
    match /memorial_chats/{uid}/{petId}/messages/{messageId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // FCMトークン（本人のみ読み書き）
    match /fcmTokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
