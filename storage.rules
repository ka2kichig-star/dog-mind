rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 虹の橋：公開ページのため、画像は誰でも読み込み可能にする。書き込みは本人のみ。
    match /memorials/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // 診断履歴：本人だけのプライベート領域
    match /history/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
